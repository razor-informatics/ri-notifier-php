{
    "name": "razor-informatics/ri-notifier-php",
    "description": "Official PHP SDK for Razor Informatics Notifier Project",
    "keywords": ["sms", "text message", "razor informatics", "api", "notifier"],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "RazorInformatics\\RiNotifierPhp\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Razor Informatics",
            "email": "info@razorinformatics.co.ke",
            "homepage": "https://razorinformatics.co.ke"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.3",
        "guzzlehttp/guzzle": "^7.10 || ^8.2",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    },
    "autoload-dev": {
        "psr-4": {
            "RazorInformatics\\RiNotifierPhp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
